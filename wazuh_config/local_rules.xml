<group name="eol,eol_risk,">

  <rule id="100420" level="5">
    <decoded_as>json</decoded_as>
    <field name="risk_level">Low</field>
    <description>EOL Risk - Low: $(agent_name) running EOL $(platform) $(version)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100421" level="8">
    <decoded_as>json</decoded_as>
    <field name="risk_level">Medium</field>
    <description>EOL Risk - Medium: $(agent_name) running EOL $(platform) $(version)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100422" level="10">
    <decoded_as>json</decoded_as>
    <field name="risk_level">High</field>
    <description>EOL Risk - High: $(agent_name) running EOL $(platform) $(version) - CVEs found</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100423" level="14">
    <decoded_as>json</decoded_as>
    <field name="risk_level">Critical</field>
    <description>EOL Risk - CRITICAL: $(agent_name) running EOL $(platform) $(version) with actively exploited CVE (CISA KEV)</description>
    <options>no_full_log</options>
    <group>attack,</group>
  </rule>

</group>
